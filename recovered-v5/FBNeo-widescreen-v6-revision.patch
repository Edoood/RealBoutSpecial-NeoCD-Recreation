+            if(wideMargin){
+                // Original games park unused sprites just outside 0..319.
+                // Expanding their clipping rectangle exposes stale HUD/actor tiles.
+                if(nBankXPos>=rffsClipLeft-nBankXZoom && nBankXPos<rffsClipRight)
+                    RenderBank[nBankXZoom+16]();
+            }else if(nBankXPos>=0 && nBankXPos<nNeoScreenWidth-nBankXZoom-1){
+                RenderBank[nBankXZoom]();
+            }else if(nBankXPos>=-nBankXZoom && nBankXPos<nNeoScreenWidth){
+                RenderBank[nBankXZoom+16]();
+            }
+            nBankXPos-=bankOffset;
+            const auto& layer=RffsWideLayers[zBank];
+            if(RffsWideTraceEnabled() && layer.object && !(BankAttrib02&0x40) &&
+                nCurrentFrame>=3950 && nCurrentFrame<=4150)
+                printf("WIDE_DRAW f=%d slice=%d bank=%03x age=%d x=%d h=%d expected=%d\n",
+                    nCurrentFrame,nSliceStart,zBank,nCurrentFrame-layer.frame,nBankXPos,nBankSize,layer.height);
+
+            if(wideMargin && rffsIsLayerBank[zBank] && !(BankAttrib02&0x40) &&
+                layer.height==nBankSize && nBankXZoom==15){
+                if(RffsWideTraceEnabled() && nCurrentFrame%100==0 && nCurrentFrame>=3000 && nCurrentFrame<=5800)
+                    printf("WIDE_MAP frame=%d bank=%03x scroll=%d x=%d same=%d row0=%04x/%04x row1=%04x/%04x\n",nCurrentFrame,zBank,layer.scroll,nBankXPos,
+                        memcmp(pBank,layer.columns[7],layer.height*4)==0,pBank[0],layer.columns[7][0],pBank[2],layer.columns[7][2]);
+                auto* originalBank=pBank;const INT32 originalX=nBankXPos;
+                rffsClipLeft=0;rffsClipRight=nNeoScreenWidth;rffsExtraColumns=true;
+                for(INT32 i=0;i<16;++i){
+                    const INT32 relative=i<8?i-8:i+13;
+                    nBankXPos=originalX+bankOffset+relative*16;
+                    if(nBankXPos>=-15 && nBankXPos<nNeoScreenWidth){
+                        pBank=const_cast<UINT16*>(layer.columns[i]);
+                        RenderBank[15+16]();
+                    }
+                }
+                pBank=originalBank;nBankXPos=originalX;rffsExtraColumns=false;
+            }
 		}
+        if (rffsStageViewport && zBank == rffsLastLayerEndBank) {
+            renderCulledStageActors(false);
+        }
 	}
 
